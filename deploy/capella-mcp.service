[Unit]
Description=Capella Fabric Generator MCP Server
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/capella_fabric_generator
Environment="CAPELLA_TOOLS_PATH=/opt/capella_tools"
# Where the ELK layout binary is cached. render_diagram_view lays out a
# generated view by calling ELK in a subprocess, and the binary is looked
# up under the cache directory -- which defaults to $HOME/.cache. www-data
# has no usable HOME under systemd, so without this the lookup lands
# somewhere unwritable and every single call re-downloads 50MB from
# GitHub, or fails. Pointing it at a directory www-data owns makes the
# deploy-time pre-fetch (deploy/README.md 4b) actually take effect.
Environment="XDG_CACHE_HOME=/var/lib/capella-fabric/cache"
# Cartenza co-deploy only (note-0086). Both files are optional, so the
# standalone droplet -- where kp-auth isn't installed and github_pat is passed
# directly -- runs fine with neither present. Do not drop either `-`.
#
# /etc/cartenza.env is the fleet's single source of truth, read by all five kp
# units (note-0090). This unit was the one service outside it, keeping its own
# copy of the shared values, and that is exactly the service that drifted: when
# the dev droplet was promoted to production, every kp service picked up the new
# hosts from the shared file and capella kept a stale KP_CONNECT_BASE_URL, so a
# production session handed a user a connect link on dev.connect.cartenza.ai.
# Reading the shared file first means host and secret values can no longer be
# missed one service at a time.
EnvironmentFile=-/etc/cartenza.env
# Capella's own values only -- PYTHONPATH, CAPELLA_VIEW_SECRET. Listed second so
# it still wins on anything it does set, which is what makes a one-off override
# possible without editing the shared file. Note CAPELLA_VIEW_SECRET must NOT be
# set to CARTENZA_CONNECT_SECRET_KEY's value: one secret per purpose.
EnvironmentFile=-/etc/capella-mcp.env
ExecStart=/opt/capella_fabric_generator/.venv/bin/python mcp_server.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/capella-fabric/mcp-access.log
StandardError=append:/var/log/capella-fabric/mcp-error.log

[Install]
WantedBy=multi-user.target
